#!/bin/bash
set -euo pipefail
umask 077
dnf install -y docker python3 python3-boto3
systemctl enable --now docker
mkdir -p /etc/acartomante /opt/acartomante /srv/acartomante
cat > /etc/acartomante/host.json <<'CONFIG'
${host_config}
CONFIG
cat > /opt/acartomante/manage.py <<'PYTHON'
${manager}
PYTHON
chmod 700 /opt/acartomante/manage.py
# Volume de dados separado: só formatar um dispositivo comprovadamente vazio.
disk="/dev/disk/by-id/nvme-Amazon_Elastic_Block_Store_${volume_id}"
for attempt in $(seq 1 120); do
  [ -b "$disk" ] && break
  [ -b /dev/xvdf ] && disk=/dev/xvdf && break
  sleep 2
done
[ -b "$disk" ] || { echo 'EBS persistente não foi anexado.' >&2; exit 1; }
fs=$(blkid -s TYPE -o value "$disk" || true)
if [ -z "$fs" ]; then
  [ -z "$(wipefs -n "$disk")" ] || { echo 'Assinatura de disco desconhecida; formatação recusada.' >&2; exit 1; }
  mkfs.ext4 "$disk"
elif [ "$fs" != ext4 ]; then
  echo 'Volume persistente não é ext4; verifique a configuração.' >&2
  exit 1
fi
uuid=$(blkid -s UUID -o value "$disk")
grep -q "UUID=$uuid " /etc/fstab || echo "UUID=$uuid /srv/acartomante ext4 defaults,nodev,nosuid 0 2" >> /etc/fstab
mountpoint -q /srv/acartomante || mount /srv/acartomante
mkdir -p /srv/acartomante/data/{redis,cache,caddy,caddy-config} /srv/acartomante/releases
chown -R 10001:10001 /srv/acartomante/data/{cache,caddy,caddy-config}
# Garante que Docker não suba containers sobre uma pasta vazia no próximo boot.
mkdir -p /etc/systemd/system/docker.service.d
cat > /etc/systemd/system/docker.service.d/volume.conf <<'UNIT'
[Unit]
RequiresMountsFor=/srv/acartomante
UNIT
cat > /etc/systemd/system/acartomante.service <<'UNIT'
[Unit]
Description=ACartomanteRAG
After=network-online.target docker.service
Requires=docker.service
RequiresMountsFor=/srv/acartomante
[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/python3 /opt/acartomante/manage.py start
TimeoutStartSec=1200
[Install]
WantedBy=multi-user.target
UNIT
cat > /etc/systemd/system/acartomante-backup.service <<'UNIT'
[Unit]
Description=Snapshot consistente Redis para S3
RequiresMountsFor=/srv/acartomante
After=docker.service
[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /opt/acartomante/manage.py backup
UNIT
cat > /etc/systemd/system/acartomante-backup.timer <<'UNIT'
[Unit]
Description=Backup diário ACartomanteRAG
[Timer]
OnCalendar=*-*-* 06:00:00 UTC
Persistent=true
[Install]
WantedBy=timers.target
UNIT
# Compose oficial, versão fixa e checksum verificado.
compose_version=v2.39.4
install -d /usr/local/lib/docker/cli-plugins
curl -fsSL "https://github.com/docker/compose/releases/download/$compose_version/docker-compose-linux-x86_64" -o /tmp/docker-compose-linux-x86_64
curl -fsSL "https://github.com/docker/compose/releases/download/$compose_version/docker-compose-linux-x86_64.sha256" -o /tmp/docker-compose.sha256
(cd /tmp && sha256sum -c docker-compose.sha256)
install -m 755 /tmp/docker-compose-linux-x86_64 /usr/local/lib/docker/cli-plugins/docker-compose
systemctl daemon-reload
systemctl enable --now acartomante.service acartomante-backup.timer
echo 'Host preparado. ETL e deploy aguardam execução explícita.'
