acme_email           = "SEU_EMAIL"
budget_email         = "SEU_EMAIL"
github_repository_id = "ID_NUMERICO_DO_REPOSITORIO"
# ami_id = "ami-..." # Fixar após o primeiro plan.
# hosted_zone_id = "Z..." # Se já usa Route 53 para o domínio.
# oidc_provider_arn = "arn:aws:iam::CONTA:oidc-provider/token.actions.githubusercontent.com"
