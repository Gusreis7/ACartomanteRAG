{
	admin off
	email {$ACME_EMAIL}
	auto_https disable_redirects
}
https://{$APP_DOMAIN} {
	tls {
		issuer acme {
			disable_http_challenge
		}
	}
	encode gzip
	request_body {
		max_size 32KiB
	}
	header Strict-Transport-Security "max-age=31536000"
	header -Server
	@operational path /health /ready
	respond @operational 404
	reverse_proxy api:8000 {
		# Sobrescreve qualquer valor enviado pelo cliente; não usa X-Forwarded-For.
		header_up X-Acartomante-Client-IP {http.request.remote.host}
		transport http {
			dial_timeout 5s
			response_header_timeout 140s
		}
	}
}
