# Referência para comandos executados no notebook com AWS SSO/profile.
# Na EC2, runtime.env é gerado pelo script a partir de SSM + Terraform.
AWS_REGION=us-east-1
STORAGE_PROVIDER=s3
CONFIG_FILE=config/config.aws.yaml
ENV_FILE=config/aws.env
RAW_BUCKET=
BRONZE_BUCKET=
SILVER_BUCKET=
EMBEDDING_INDEXES_BUCKET=
BENCHMARKS_BUCKET=
ENRICHMENT_BUCKET=
QDRANT_URL=https://SEU_CLUSTER.us-east-1-0.aws.cloud.qdrant.io
QDRANT_API_KEY=
# Somente a API utiliza o manifest de promoção. Não definir durante ETL.
# DATA_RELEASE_KEY=production/current.json
