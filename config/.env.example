# Preserve os caminhos e as credenciais da instalação existente.
# Gere novos segredos com: python -c 'import secrets; print(secrets.token_hex(32))'
RUSTFS_ACCESS_KEY=change-me
RUSTFS_SECRET_KEY=change-me
QDRANT_API_KEY=change-me
# Use hexadecimal para a senha também ser válida, sem escaping, na URL Redis.
REDIS_PASSWORD=

# Caminhos absolutos dos volumes JÁ EXISTENTES; não troque por pastas vazias.
RUSTFS_VOLUME=
QDRANT_VOLUME=
REDIS_VOLUME=

# ÚNICO endpoint publicado: http://<API_BIND_IP>:<API_PORT>
# Configuração local: mantenha config/.env fora do Git.
# CI define 127.0.0.1; deploy recebe vars.API_BIND_IP do repositório.
# Informe o IP LAN específico do notebook; nunca 0.0.0.0 ou ::.
# Consulte: ip -4 -brief address show scope global
API_BIND_IP=
API_PORT=8000
# Hostname LAN opcional, separado por vírgulas. O IP acima já é permitido.
API_EXTRA_HOSTS=
API_CPU_THREADS=4
# HTTP na LAN: false. Habilitar somente quando a entrada usar HTTPS.
SESSION_COOKIE_SECURE=false

# Consumidor no host (ConfigManager/CLI); não publica as portas dos backends.
# O serviço tools usa DNS interno do Compose automaticamente.
RUSTFS_ENDPOINT=http://localhost:9000
QDRANT_URL=http://localhost:6333
REDIS_URL=redis://:change-me@localhost:6379/0
OLLAMA_BASE_URL=http://localhost:11434

# Consumidor no container. Ollama permanece no host, com sua GPU/modelos.
# O processo precisa escutar em uma interface de bridge acessível ao container.
OLLAMA_BASE_URL_DOCKER=http://host.docker.internal:11434
